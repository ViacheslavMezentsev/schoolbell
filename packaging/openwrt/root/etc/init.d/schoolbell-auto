#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    /usr/sbin/schoolbell-package initialize || return 1
    procd_open_instance
    procd_set_param command /usr/bin/lua /usr/sbin/schoolbell-auto
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
