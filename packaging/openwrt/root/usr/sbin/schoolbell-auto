#!/usr/bin/lua
-- No dependency on a browser, modbusd, serial port, cron or NTP configuration.
package.path='/usr/share/schoolbell-editor/lua/?.lua;'..package.path
local n=require('nixio');local fs=require('nixio.fs')
local A=require('schoolbell.automatic');local Store=require('schoolbell.automatic_store')
local C=require('schoolbell.media_codec');local Controls=require('schoolbell.controls')
local Player=require('schoolbell.sound_test')
local lock=assert(n.open('/tmp/schoolbell-auto.lock','w',600))
assert(lock:lock('tlock'),'another executor is running')
local function mono()
 local f=assert(io.open('/proc/uptime','r'));local t=f:read(64);f:close();return assert(tonumber(t:match('^[%d.]+')))
end
local metrics_ok=true
local function audit(action,bell)
 local r=require('schoolbell.journal').request(Store.root,action,nil,bell)
 if r.metrics_warning then metrics_ok=false end
 return r
end
local mailbox=require('schoolbell.clock_mailbox').system('worker')
local cached,active,resumed
local function resume(revision,generation)
  if not fs.mkdir(Player.lock,700)then return {ok=false,code='busy'}end
  local ok,v=pcall(function()return Store.transaction(Store.resume,revision,generation,Store.environment(),function(plan)
   return require('schoolbell.media_web').plan_ready(plan)
  end,cached,active)end)
  local closed=fs.rmdir(Player.lock)
  if not ok or not closed then return {ok=false,code='automatic_storage'}end
  if v.ok then resumed=v end
  return {ok=v.ok,code=v.code,generation=v.ok and v.state.generation or nil}
end
local set_clock=require("schoolbell.clock_set").system(
 function()return Store.environment().zone end,mono)
local system_command,system_busy=require('schoolbell.system_actions').system(mono)
local function commands()
 mailbox.process(function(q,meta)
  if system_busy()then return {ok=false,code='reboot_pending'}end
  if q.action:match('^system_')then
   local value=system_command(q)
   if q.action~='system_prepare'then pcall(audit,value.ok and (q.action=='system_reset'and 'system_reset' or 'system_reboot')or 'system_failed')end
   return value
  end
  local setting=q.action=="set_time" or q.action=="set_prepare"
  if not setting and q.action~='resume' then return {ok=false,code='invalid_action'} end
  local value
  if setting then value=set_clock(q,meta) else value=resume(q.revision,tonumber(q.generation)) end
  if q.action=='set_time' then pcall(audit,value.ok and 'clock_set_ok' or 'clock_set_failed')
  elseif q.action=='resume' then pcall(audit,value.ok and 'auto_enabled' or 'auto_blocked') end
  return value
 end)
end
local Metrics=require('schoolbell.bell_metrics')
metrics_ok=Metrics.reconcile(Store.root)
local metrics_attempt=mono()
local Status=require('schoolbell.automatic_status')
Status.invalidate()
local engine,key,events,calendar_error,previous_state
local started=Store.environment()
local boot_recorded=false
local prepared_claim
local last_result
local function status(v)
 v.last_result=last_result
 v.metrics_warning=not metrics_ok or nil
 v.updated=os.time();v.uptime=math.floor(mono())
 local f=assert(io.open('/tmp/schoolbell-auto-status.next','wb'));assert(f:write(C.encode(v)));assert(f:close())
 assert(fs.rename('/tmp/schoolbell-auto-status.next','/tmp/schoolbell-auto-status.json'))
 if active then
  local published=pcall(Status.publish,cached,v,started.boot)
  if not published then pcall(Status.invalidate)end
 end
end
local function tick()
 assert(not fs.lstat(Store.root..'/package.pending'),'package operation pending')
 if not metrics_ok and mono()-metrics_attempt>=60 then metrics_attempt=mono();metrics_ok=Metrics.reconcile(Store.root)end
 if not boot_recorded then
  local recorded=Store.transaction(require('schoolbell.journal').record_boot,started.boot,math.max(0,os.time()-math.floor(mono())))
  boot_recorded=recorded.ok
 end
 commands()
 local raw=Store.raw();local env=Store.environment();local now,up=env.now,mono()
 if started.zone~=env.zone then os.exit(0)end -- procd respawns with libc's new TZ
 if raw~=cached or not active then
  local v=resumed and resumed.raw==raw and resumed.state or Store.decode(raw)
  if v.enabled and v.boot~=env.boot then
   local stopped=Store.transaction(Store.on_boot,env.boot)
   assert(stopped.ok,'boot state');v=stopped.state;raw=stopped.raw
  end
  if not active or active.generation~=v.generation then
   -- Persist the startup floor too: downtime followed by clock rollback and
   -- another restart must not resurrect an event missed during downtime.
   if v.enabled and v.boot==env.boot and v.zone==env.zone then
    local checkpoint=Store.transaction(Store.advance,v.generation,now,raw,v)
    assert(checkpoint.ok,'startup checkpoint');v=checkpoint.state
    raw=assert(checkpoint.raw)
   end
   prepared_claim=nil
   engine=A.new(now,up,v.watermark);key=nil
  end
  active=v;cached=raw
 end
 resumed=nil
 local v={ok=true,enabled=active.enabled,generation=active.generation,revision=active.revision,now=now}
 if active.plan then
  v.mode=active.plan.mode or 'annual'
  v.context=require('schoolbell.schedule_store').context(active.plan,env.date)
 end
 if not active.enabled then v.state='disabled'
 elseif active.boot~=env.boot then v.state='confirm_clock'
 elseif active.zone~=env.zone or started.zone~=env.zone then v.state='timezone_changed'
 elseif now<1577836800 or now>=2145916800 then v.state='clock_invalid'
 else
  local k=active.generation..'/'..env.date
  if key~=k then events,calendar_error=A.events(active.plan,env.date);key=k end
  if not events then v.state=calendar_error
  else
   local controls=Controls.snapshot()
   v.state=now<engine.watermark() and 'backward_hold' or not controls.ok and 'control_unreadable' or controls.muted and 'muted' or 'running'
   for _,e in ipairs(events)do if e.utc>math.max(now,active.watermark,engine.watermark())then v.next=e;break end end
   local event,skip,forward_jump=engine.step(now,up,events,not controls.ok or controls.muted)
   if skip then v.skipped=skip end
   if not event and forward_jump then
    local checkpoint=Store.transaction(Store.advance,active.generation,now)
    if checkpoint.ok then
     active=checkpoint.state;cached=assert(checkpoint.raw)
    else v.state='claim_failed' end
   end
   if not event and v.next and v.next.utc-now>3 and
      (not prepared_claim or prepared_claim.expected~=cached or prepared_claim.state.watermark~=v.next.utc) then
    prepared_claim=Store.prepare_claim(active,cached,v.next.utc)
   end
   if event then
    local prepared=prepared_claim
    prepared_claim=nil
    if prepared and (prepared.expected~=cached or prepared.state.watermark~=event.utc) then prepared=nil end
    local claimed=Store.transaction(Store.claim,active.generation,event.utc,os.time(),prepared)
    if not claimed.ok then v.state='claim_failed'
    else
     active=claimed.state;cached=assert(claimed.raw);v.state='playing';v.event=event;v.next=nil
     local reported=false
     local bell
     local function report_attempt()
      if reported then return end
      reported=true
      bell={kind=event.kind or 'main',due=os.date('%d.%m.%Y %H:%M %z',event.utc),plan=v.context.plan}
      for _,schedule in ipairs(active.plan.schedules or {}) do
       if schedule.id==event.schedule_id then bell.schedule=schedule.name;break end
      end
      pcall(audit,'auto_requested',bell)
     end
     local io=Player.system(event.media);local muted=io.muted;local expected=cached
     local sleep=io.sleep;local last_status=math.floor(mono())
     io.sleep=function()
      local tick=math.floor(mono())
      if tick~=last_status then commands();status(v);last_status=tick end
      sleep()
     end
     local missed=false;local spawn=io.spawn
     io.spawn=function()
      local t=os.time()
      if t<event.utc or t-event.utc>2 then missed=true;return nil end
      local pid=spawn()
      report_attempt()
      if pid then pcall(status,v) end
      return pid
     end
     io.muted=function()
      local ok,raw_now=pcall(Store.raw)
      local good,current=pcall(Store.environment)
      return muted() or not ok or raw_now~=expected or not good or current.zone~=active.zone
     end
     -- A slow claim/audit must never turn into a late launch.
     local result
     if skip then result={ok=false,state=skip}
     elseif os.time()-event.utc>2 or os.time()<event.utc then result={ok=false,state='expired'}
     else result=Player.run(io);if missed then result.state='expired' end end
     report_attempt()
     v.state=controls.muted and 'muted' or 'running';v.result=result.state;v.event=nil
     last_result={state=result.state,exit_code=result.exit_code,time=os.time()}
     local outcome=result.ok and 'auto_ok' or result.state=='expired' and 'auto_expired'
      or result.state=='unavailable' and 'auto_audio_unavailable'
      or (result.state=='muted' or skip) and 'auto_skipped' or 'auto_player_failed'
     audit(outcome,bell)
    end
   end
  end
 end
 if v.result then previous_state=nil
 elseif v.state~=previous_state then
  if v.state~='running' and v.state~='disabled' and v.state~='muted' then audit('auto_blocked')end
  previous_state=v.state
 end
 status(v)
end
while true do
 local ok=pcall(tick)
 if not ok then pcall(status,{ok=false,state='executor_error'}) end
 n.nanosleep(1,0)
end
